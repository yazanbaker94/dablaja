{
  "name": "dablaja",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arabic-first live dubbing Chrome extension MVP",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:server": "python -m unittest server/test_dablaja.py",
    "check": "node scripts/check.mjs && node scripts/check-element-bindings.mjs && npx eslint src",
    "validate": "node scripts/validate-manifest.mjs && node scripts/validate-store-assets.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package": "npm run package:dev",
    "package:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Mode dev",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Mode release",
    "verify": "npm run test && npm run test:server && npm run check && npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "puppeteer-core": "^25.8.0"
  }
}
